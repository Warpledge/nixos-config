  {
    "name": "Steam Resize Fill",
    "note": "XWayland has no synchronized resize, so resizing shows frame area Steam hasn't painted yet; a solid border fills it. Must stay after the theme's styling rules.",
    "draw-border-with-background": true,
    "matches": [
      {
        "app-id": "^steam$"
      }
    ]
  },
  {
    "name": "ProtonPlus",
    "matches": [
      {
        "app-id": "^com\\.vysp3r\\.ProtonPlus$"
      }
    ],
    "opacity": 0.8
