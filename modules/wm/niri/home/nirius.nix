#=====================================================================#
# NIRIUS ADDON
#=====================================================================#
{pkgs, ...}: {
  #--------------------------------------------------------------------#
  #-- Nirius Packages
  #--------------------------------------------------------------------#
  home.packages = with pkgs; [
    nirius # scratchpad, focus-or-spawn, follow mode
  ];

  #--------------------------------------------------------------------#
  #-- Nirius Configuration
  #--------------------------------------------------------------------#
  programs.niri = {
    settings = {
      #--- Autostart
      spawn-at-startup = [
        {command = ["niriusd"];}
      ];

      #--- Keybinds
      binds = {
        "Mod+0".action.spawn = ["nirius" "scratchpad-toggle"];
      };
    };
  };
}
