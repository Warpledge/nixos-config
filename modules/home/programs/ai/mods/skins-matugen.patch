+// The matugen skin: DMS renders this file from the wallpaper (nixos-config patch).
+async function matugenSkin($: EngineInterface): Promise<Record<string, CustomSkin>> {
+  try {
+    const dir = (await $.env.get('XDG_CONFIG_HOME')) || `${await $.env.get('HOME')}/.config`
+    const raw = JSON.parse(String(await $.fs.read(`${dir}/claude-skins/matugen.json`)))
+    const skin = buildCustom(raw, undefined)
+    return typeof skin === 'string' ? {} : { [skin.name]: skin }
+  } catch {
+    return {}
+  }
+}
