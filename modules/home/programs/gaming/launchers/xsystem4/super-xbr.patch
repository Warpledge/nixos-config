diff --git a/src/video.c b/src/video.c
index e1ebcd9..badcebf 100644
--- a/src/video.c
+++ b/src/video.c
@@ -133,6 +133,164 @@ void gfx_load_shader(struct shader *dst, const char *vertex_shader_path, const c
 	dst->prepare = NULL;
 }
 
+/*
+ * Scaling of the final frame to the window. Alt+N cycles the modes.
+ * SCALE_XBR runs Super-xBR (shaders/superxbr.*.glsl) to 2x, then scales linearly.
+ */
+enum scale_mode { SCALE_XBR, SCALE_NEAREST, SCALE_LINEAR };
+static enum scale_mode scale_mode = SCALE_XBR;
+
+struct xbr_shader {
+	struct shader s;
+	GLint source_size;
+	GLint orig;
+};
+
+struct xbr_pass_data {
+	struct xbr_shader *shader;
+	GLfloat source_w, source_h;
+	GLuint orig;
+};
+
+static struct xbr_shader xbr_shaders[3];
+static bool xbr_loaded;
+// 0: pass 0 output (1x), 1: pass 1 output (2x), 2: pass 2 output (2x, presented)
+static struct texture xbr_tex[3];
+static GLuint xbr_fb[3];
+static int xbr_w, xbr_h;
+
+static void xbr_prepare(struct gfx_render_job *job, void *data)
+{
+	struct xbr_pass_data *d = data;
+	glUniform2f(d->shader->source_size, d->source_w, d->source_h);
+	if (d->orig) {
+		glActiveTexture(GL_TEXTURE1);
+		glBindTexture(GL_TEXTURE_2D, d->orig);
+		glUniform1i(d->shader->orig, 1);
+		glActiveTexture(GL_TEXTURE0);
+	}
+}
+
+static void xbr_load_shader(struct xbr_shader *dst, int pass)
+{
+	char defines[32];
+	snprintf(defines, sizeof(defines), "#define XBR_PASS %d\n", pass);
+
+	GLuint program = glCreateProgram();
+	glAttachShader(program, gfx_load_shader_file("shaders/superxbr.v.glsl", GL_VERTEX_SHADER, defines));
+	glAttachShader(program, gfx_load_shader_file("shaders/superxbr.f.glsl", GL_FRAGMENT_SHADER, defines));
+	glLinkProgram(program);
+
+	GLint link_success;
+	glGetProgramiv(program, GL_LINK_STATUS, &link_success);
+	if (!link_success)
+		ERROR("Failed to link Super-xBR shader (pass %d)", pass);
+
+	dst->s.program = program;
+	dst->s.world_transform = glGetUniformLocation(program, "world_transform");
+	dst->s.view_transform = glGetUniformLocation(program, "view_transform");
+	dst->s.texture = glGetUniformLocation(program, "tex");
+	dst->s.vertex_pos = glGetAttribLocation(program, "vertex_pos");
+	dst->s.vertex_uv = glGetAttribLocation(program, "vertex_uv");
+	dst->s.prepare = xbr_prepare;
+	dst->source_size = glGetUniformLocation(program, "source_size");
+	dst->orig = glGetUniformLocation(program, "orig");
+}
+
+static void xbr_texture_init(int i, int w, int h, GLint filter)
+{
+	gfx_delete_texture(&xbr_tex[i]);
+	glGenTextures(1, &xbr_tex[i].handle);
+	glBindTexture(GL_TEXTURE_2D, xbr_tex[i].handle);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glBindTexture(GL_TEXTURE_2D, 0);
+	xbr_tex[i].w = w;
+	xbr_tex[i].h = h;
+
+	if (!xbr_fb[i])
+		glGenFramebuffers(1, &xbr_fb[i]);
+	glBindFramebuffer(GL_FRAMEBUFFER, xbr_fb[i]);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, xbr_tex[i].handle, 0);
+}
+
+static void xbr_pass(int pass, GLuint src, int src_w, int src_h, GLuint orig)
+{
+	static mat4 identity = GLM_MAT4_IDENTITY_INIT;
+	// Unit quad -> clip space without the y-flip, so each pass keeps the orientation
+	static mat4 pass_transform = MAT4(
+		2, 0, 0, -1,
+		0, 2, 0, -1,
+		0, 0, 1,  0,
+		0, 0, 0,  1);
+	struct xbr_pass_data data = {
+		.shader = &xbr_shaders[pass],
+		.source_w = src_w,
+		.source_h = src_h,
+		.orig = orig
+	};
+	struct gfx_render_job job = {
+		.shader = &xbr_shaders[pass].s,
+		.shape = GFX_RECTANGLE,
+		.texture = src,
+		.world_transform = identity[0],
+		.view_transform = pass_transform[0],
+		.data = &data
+	};
+	glBindFramebuffer(GL_FRAMEBUFFER, xbr_fb[pass]);
+	glViewport(0, 0, xbr_tex[pass].w, xbr_tex[pass].h);
+	gfx_render(&job);
+}
+
+static void set_filter(GLuint texture, GLint filter)
+{
+	glBindTexture(GL_TEXTURE_2D, texture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+	glBindTexture(GL_TEXTURE_2D, 0);
+}
+
+// Returns the texture holding the 2x Super-xBR image of the current view.
+static GLuint xbr_upscale(void)
+{
+	if (!xbr_loaded) {
+		for (int i = 0; i < 3; i++)
+			xbr_load_shader(&xbr_shaders[i], i);
+		xbr_loaded = true;
+	}
+	int w = view->w, h = view->h;
+	if (w != xbr_w || h != xbr_h) {
+		xbr_texture_init(0, w, h, GL_NEAREST);
+		xbr_texture_init(1, w * 2, h * 2, GL_NEAREST);
+		xbr_texture_init(2, w * 2, h * 2, GL_LINEAR);
+		xbr_w = w;
+		xbr_h = h;
+	}
+
+	glDisable(GL_BLEND);
+	set_filter(view->handle, GL_NEAREST);
+	xbr_pass(0, view->handle, w, h, 0);
+	xbr_pass(1, xbr_tex[0].handle, w, h, view->handle);
+	xbr_pass(2, xbr_tex[1].handle, w * 2, h * 2, 0);
+	set_filter(view->handle, GL_LINEAR);
+	glActiveTexture(GL_TEXTURE1);
+	glBindTexture(GL_TEXTURE_2D, 0);
+	glActiveTexture(GL_TEXTURE0);
+	glEnable(GL_BLEND);
+
+	return xbr_tex[2].handle;
+}
+
+void gfx_cycle_scale_mode(void)
+{
+	static const char *names[] = { "Super-xBR", "nearest", "linear" };
+	scale_mode = (scale_mode + 1) % 3;
+	NOTICE("Scale filter: %s", names[scale_mode]);
+}
+
 static int gl_initialize(void)
 {
 	gfx_load_shader(&default_shader, "shaders/render.v.glsl", "shaders/render.f.glsl");
@@ -423,6 +581,8 @@ static void gfx_update_frame_rate_counter(void)
 
 void gfx_swap(void)
 {
+	GLuint present = scale_mode == SCALE_XBR ? xbr_upscale() : view->handle;
+
 	glBindFramebuffer(GL_FRAMEBUFFER, 0);
 	glViewport(sdl.viewport.x, sdl.viewport.y, sdl.viewport.w, sdl.viewport.h);
 	gfx_clear();
@@ -435,12 +595,16 @@ void gfx_swap(void)
 	struct gfx_render_job job = {
 		.shader = &default_shader,
 		.shape = GFX_RECTANGLE,
-		.texture = view->handle,
+		.texture = present,
 		.world_transform = mw_transform[0],
 		.view_transform = wv_transform[0],
