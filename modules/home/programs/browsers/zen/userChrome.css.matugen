/* Catppuccin Mocha Mauve userChrome.css, as a DMS matugen template (zen/theme.nix) */

@media (prefers-color-scheme: dark) {
	:root {
		--zen-colors-primary: {{colors.surface_container_high.default.hex}} !important;
		--zen-primary-color: {{colors.primary.default.hex}} !important;
		--zen-colors-secondary: {{colors.surface_container_high.default.hex}} !important;
		--zen-colors-tertiary: {{colors.surface.default.hex}} !important;
		--zen-colors-border: {{colors.primary.default.hex}} !important;
		--toolbarbutton-icon-fill: {{colors.primary.default.hex}} !important;
		--lwt-text-color: {{colors.on_surface.default.hex}} !important;
		--toolbar-field-color: {{colors.on_surface.default.hex}} !important;
		--tab-selected-textcolor: {{colors.primary.default.hex}} !important;
		--toolbar-field-focus-color: {{colors.on_surface.default.hex}} !important;
		--toolbar-color: {{colors.on_surface.default.hex}} !important;
		--newtab-text-primary-color: {{colors.on_surface.default.hex}} !important;
		--arrowpanel-color: {{colors.on_surface.default.hex}} !important;
		--arrowpanel-background: {{colors.background.default.hex}} !important;
		--sidebar-text-color: {{colors.on_surface.default.hex}} !important;
		--lwt-sidebar-text-color: {{colors.on_surface.default.hex}} !important;
		--lwt-sidebar-background-color: {{colors.background.default.hex}} !important;
		--toolbar-bgcolor: {{colors.surface_container_high.default.hex}} !important;
		--newtab-background-color: {{colors.background.default.hex}} !important;
		--zen-themed-toolbar-bg: {{colors.surface.default.hex}} !important;
		--zen-main-browser-background: {{colors.surface.default.hex}} !important;
		--toolbox-bgcolor-inactive: {{colors.surface.default.hex}} !important;
	}

	#permissions-granted-icon {
		color: {{colors.surface.default.hex}} !important;
	}

	.sidebar-placesTree {
		background-color: {{colors.background.default.hex}} !important;
	}

	#zen-workspaces-button {
		background-color: {{colors.background.default.hex}} !important;
	}

	#TabsToolbar {
		background-color: {{colors.surface.default.hex}} !important;
	}

	.urlbar-background {
		background-color: {{colors.background.default.hex}} !important;
	}

	.content-shortcuts {
		background-color: {{colors.background.default.hex}} !important;
		border-color: {{colors.primary.default.hex}} !important;
	}

	.urlbarView-url {
		color: {{colors.primary.default.hex}} !important;
	}

	#zenEditBookmarkPanelFaviconContainer {
		background: {{colors.background.default.hex}} !important;
	}

	#zen-media-controls-toolbar {
		& #zen-media-progress-bar {
			&::-moz-range-track {
				background: {{colors.surface_container_high.default.hex}} !important;
			}
		}
	}

	toolbar .toolbarbutton-1 {
		&:not([disabled]) {
			&:is([open], [checked])
				> :is(
					.toolbarbutton-icon,
					.toolbarbutton-text,
					.toolbarbutton-badge-stack
				) {
				fill: {{colors.background.default.hex}};
			}
		}
	}

	.identity-color-blue {
		--identity-tab-color: {{colors.primary.default.hex}} !important;
		--identity-icon-color: {{colors.primary.default.hex}} !important;
	}

	.identity-color-turquoise {
		--identity-tab-color: {{dank16.color14.default.hex}} !important;
		--identity-icon-color: {{dank16.color14.default.hex}} !important;
	}

	.identity-color-green {
		--identity-tab-color: {{dank16.color2.default.hex}} !important;
		--identity-icon-color: {{dank16.color2.default.hex}} !important;
	}

	.identity-color-yellow {
		--identity-tab-color: {{dank16.color3.default.hex}} !important;
		--identity-icon-color: {{dank16.color3.default.hex}} !important;
	}

	.identity-color-orange {
		--identity-tab-color: {{dank16.color11.default.hex}} !important;
		--identity-icon-color: {{dank16.color11.default.hex}} !important;
	}

	.identity-color-red {
		--identity-tab-color: {{dank16.color1.default.hex}} !important;
		--identity-icon-color: {{dank16.color1.default.hex}} !important;
	}

	.identity-color-pink {
		--identity-tab-color: {{dank16.color13.default.hex}} !important;
		--identity-icon-color: {{dank16.color13.default.hex}} !important;
	}

	.identity-color-purple {
		--identity-tab-color: {{colors.primary.default.hex}} !important;
		--identity-icon-color: {{colors.primary.default.hex}} !important;
	}

	hbox#titlebar {
		background-color: {{colors.surface.default.hex}} !important;
	}

	#zen-appcontent-navbar-container {
		background-color: {{colors.surface.default.hex}} !important;
	}

	/* Toolbar button icons - change sky blue to mauve */
	#back-button > .toolbarbutton-icon,
	#forward-button > .toolbarbutton-icon,
	#reload-button > .toolbarbutton-icon,
	#stop-button > .toolbarbutton-icon,
	#home-button > .toolbarbutton-icon,
	#downloads-button > .toolbarbutton-icon,
	#bookmarks-menu-button > .toolbarbutton-icon,
	#customizableui-special-spring1,
	#customizableui-special-spring2,
	#PanelUI-menu-button > .toolbarbutton-icon {
		fill: {{colors.primary.default.hex}} !important;
	}

	/* Sidebar and bookmark folder icons */
	.bookmark-item > .toolbarbutton-icon,
	.places-tree-item > .toolbarbutton-icon {
		fill: {{colors.primary.default.hex}} !important;
	}

	/* Settings/hamburger menu icon */
	#PanelUI-menu-button {
		fill: {{colors.primary.default.hex}} !important;
	}

	/* All default toolbar button icons */
	toolbarbutton:not([disabled]) > .toolbarbutton-icon {
		fill: {{colors.primary.default.hex}} !important;
	}
}
