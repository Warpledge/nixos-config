 #[tauri::command]
+pub fn open_in_mpv(url: String, subtitles: Vec<String>, start: f64, title: String) -> Result<(), String> {
+    let mut cmd = std::process::Command::new("mpv");
+    // Moku's wrapper sets these for WebKitGTK; mpv would load the wrong libraries
+    for var in ["LD_LIBRARY_PATH", "GST_PLUGIN_SYSTEM_PATH_1_0", "GIO_EXTRA_MODULES"] {
+        cmd.env_remove(var);
+    }
+    // A stream with no video track would otherwise play as invisible audio
+    cmd.arg("--force-window=yes");
+    cmd.arg(format!("--start={}", start.max(0.0)));
+    if !title.is_empty() {
+        cmd.arg(format!("--force-media-title={title}"));
+    }
+    for sub in &subtitles {
+        cmd.arg(format!("--sub-file={sub}"));
+    }
+    cmd.arg("--").arg(url);
+    let mut child = cmd.spawn().map_err(|e| e.to_string())?;
+    std::thread::spawn(move || {
+        let _ = child.wait();
+    });
+    Ok(())
+}
