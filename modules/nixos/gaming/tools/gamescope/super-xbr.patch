+
+#define XBR_EDGE_STR 0.6
+#define XBR_WEIGHT 1.0
+#define XBR_ANTI_RINGING 1.0
+#define xbr_mul(a,b) (b*a)
+
+const vec3 xbr_Y = vec3(.2126, .7152, .0722);
+
+float xbr_luma(vec3 color)
+{
+    return dot(color, xbr_Y);
+}
+
+float xbr_df(float A, float B)
+{
+    return abs(A-B);
+}
+
+/*
+                              P1
+     |P0|B |C |P1|         C     F4          |a0|b1|c2|d3|
+     |D |E |F |F4|      B     F     I4       |b0|c1|d2|e3|   |e1|i1|i2|e2|
+     |G |H |I |I4|   P0    E  A  I     P3    |c0|d1|e2|f3|   |e3|i3|i4|e4|
+     |P2|H5|I5|P3|      D     H     I5       |d0|e1|f2|g3|
+                           G     H5
+                              P2
+*/
+
+float xbr_d_wd(float wp1, float wp2, float wp3, float wp4, float wp5, float wp6,
+               float b0, float b1, float c0, float c1, float c2, float d0, float d1,
+               float d2, float d3, float e1, float e2, float e3, float f2, float f3)
+{
+    return (wp1*(xbr_df(c1,c2) + xbr_df(c1,c0) + xbr_df(e2,e1) + xbr_df(e2,e3))
+        + wp2*(xbr_df(d2,d3) + xbr_df(d0,d1)) + wp3*(xbr_df(d1,d3) + xbr_df(d0,d2))
+        + wp4*xbr_df(d1,d2) + wp5*(xbr_df(c0,c2) + xbr_df(e1,e3))
+        + wp6*(xbr_df(b0,b1) + xbr_df(f2,f3)));
+}
+
+float xbr_hv_wd(float wp1, float wp2, float wp3, float wp4, float wp5, float wp6,
+                float i1, float i2, float i3, float i4, float e1, float e2, float e3, float e4)
+{
+    return (wp4*(xbr_df(i1,i2)+xbr_df(i3,i4))
+        + wp1*(xbr_df(i1,e1)+xbr_df(i2,e2)+xbr_df(i3,e3)+xbr_df(i4,e4))
+        + wp3*(xbr_df(i1,e2)+xbr_df(i3,e4)+xbr_df(e1,i2)+xbr_df(e3,i4)));
+}
+
+vec3 xbr_min4(vec3 a, vec3 b, vec3 c, vec3 d)
+{
+    return min(a, min(b, min(c, d)));
+}
+
+vec3 xbr_max4(vec3 a, vec3 b, vec3 c, vec3 d)
+{
+    return max(a, max(b, max(c, d)));
+}
+
+vec3 xbr_tap(uint slot, vec2 uv)
+{
+    return textureLod(s_samplers[slot], uv, 0.0).rgb;
+}
+
+// uv: centre of the output pixel, normalized. srcSize: size of s_samplers[0].
+vec3 xbrPass(vec2 uv, vec2 srcSize)
+{
+#if XBR_PASS == 0
+    const float wp1 = 2.0, wp2 = 1.0, wp3 = -1.0, wp4 = 4.0, wp5 = -1.0, wp6 = 1.0;
+    const float weight1 = XBR_WEIGHT*1.29633/10.0;
+    const float weight2 = XBR_WEIGHT*1.75068/10.0/2.0;
+#elif XBR_PASS == 1
+    const float wp1 = 8.0, wp2 = 0.0, wp3 = 0.0, wp4 = 0.0, wp5 = 0.0, wp6 = 0.0;
+    const float weight1 = XBR_WEIGHT*1.75068/10.0;
+    const float weight2 = XBR_WEIGHT*1.29633/10.0/2.0;
+#else
+    const float wp1 = 1.0, wp2 = 0.0, wp3 = 2.0, wp4 = 3.0, wp5 = -2.0, wp6 = 1.0;
+    const float weight1 = XBR_WEIGHT*1.29633/10.0;
+    const float weight2 = XBR_WEIGHT*1.75068/10.0/2.0;
+#endif
+
+#if XBR_PASS == 1
+    // Skip pixels on the wrong grid
+    vec2 fp = fract(uv * srcSize);
+    vec2 dir = fp - vec2(0.5, 0.5);
+    if ((dir.x*dir.y) > 0.0)
+        return (fp.x > 0.5) ? xbr_tap(0, uv) : xbr_tap(1, uv);
+
+    vec2 g1 = (fp.x > 0.5) ? vec2(0.5/srcSize.x, 0.0) : vec2(0.0, 0.5/srcSize.y);
+    vec2 g2 = (fp.x > 0.5) ? vec2(0.0, 0.5/srcSize.y) : vec2(0.5/srcSize.x, 0.0);
+
+    vec3 P0 = xbr_tap(1, uv -3.0*g1        );
+    vec3 P1 = xbr_tap(0, uv         -3.0*g2);
+    vec3 P2 = xbr_tap(0, uv         +3.0*g2);
+    vec3 P3 = xbr_tap(1, uv +3.0*g1        );
+
+    vec3  B = xbr_tap(0, uv -2.0*g1     -g2);
+    vec3  C = xbr_tap(1, uv     -g1 -2.0*g2);
+    vec3  D = xbr_tap(0, uv -2.0*g1     +g2);
+    vec3  E = xbr_tap(1, uv     -g1        );
+    vec3  F = xbr_tap(0, uv             -g2);
+    vec3  G = xbr_tap(1, uv     -g1 +2.0*g2);
+    vec3  H = xbr_tap(0, uv             +g2);
+    vec3  I = xbr_tap(1, uv     +g1        );
+
+    vec3 F4 = xbr_tap(1, uv     +g1 -2.0*g2);
+    vec3 I4 = xbr_tap(0, uv +2.0*g1     -g2);
+    vec3 H5 = xbr_tap(1, uv     +g1 +2.0*g2);
+    vec3 I5 = xbr_tap(0, uv +2.0*g1     +g2);
+#else
+    float dx = 1.0 / srcSize.x;
+    float dy = 1.0 / srcSize.y;
+#if XBR_PASS == 0
+    vec4 t1 = uv.xyxy + vec4(-dx, -dy, 2.0*dx, 2.0*dy);
+    vec4 t2 = uv.xyxy + vec4(0.0, -dy,     dx, 2.0*dy);
+    vec4 t3 = uv.xyxy + vec4(-dx, 0.0, 2.0*dx,     dy);
+    vec4 t4 = uv.xyxy + vec4(0.0, 0.0,     dx,     dy);
+#else
+    vec4 t1 = uv.xyxy + vec4(-2.0*dx, -2.0*dy,  dx,  dy);
+    vec4 t2 = uv.xyxy + vec4(    -dx, -2.0*dy, 0.0,  dy);
+    vec4 t3 = uv.xyxy + vec4(-2.0*dx,     -dy,  dx, 0.0);
+    vec4 t4 = uv.xyxy + vec4(    -dx,     -dy, 0.0, 0.0);
+#endif
+
+    vec3 P0 = xbr_tap(0, t1.xy);
+    vec3 P1 = xbr_tap(0, t1.zy);
+    vec3 P2 = xbr_tap(0, t1.xw);
+    vec3 P3 = xbr_tap(0, t1.zw);
+
+    vec3  B = xbr_tap(0, t2.xy);
+    vec3  C = xbr_tap(0, t2.zy);
+    vec3 H5 = xbr_tap(0, t2.xw);
+    vec3 I5 = xbr_tap(0, t2.zw);
+
+    vec3  D = xbr_tap(0, t3.xy);
+    vec3 F4 = xbr_tap(0, t3.zy);
+    vec3  G = xbr_tap(0, t3.xw);
+    vec3 I4 = xbr_tap(0, t3.zw);
+
+    vec3  E = xbr_tap(0, t4.xy);
+    vec3  F = xbr_tap(0, t4.zy);
+    vec3  H = xbr_tap(0, t4.xw);
+    vec3  I = xbr_tap(0, t4.zw);
+#endif
+
+    float b = xbr_luma( B );
+    float c = xbr_luma( C );
+    float d = xbr_luma( D );
+    float e = xbr_luma( E );
+    float f = xbr_luma( F );
+    float g = xbr_luma( G );
+    float h = xbr_luma( H );
+    float i = xbr_luma( I );
+
+    float i4 = xbr_luma( I4 ); float p0 = xbr_luma( P0 );
+    float i5 = xbr_luma( I5 ); float p1 = xbr_luma( P1 );
+    float h5 = xbr_luma( H5 ); float p2 = xbr_luma( P2 );
+    float f4 = xbr_luma( F4 ); float p3 = xbr_luma( P3 );
+
+    /* Calc edgeness in diagonal directions. */
+    float d_edge  = (xbr_d_wd( wp1, wp2, wp3, wp4, wp5, wp6, d, b, g, e, c, p2, h, f, p1, h5, i, f4, i5, i4 )
+                   - xbr_d_wd( wp1, wp2, wp3, wp4, wp5, wp6, c, f4, b, f, i4, p0, e, i, p3, d, h, i5, g, h5 ));
+
+    /* Calc edgeness in horizontal/vertical directions. */
+    float hv_edge = (xbr_hv_wd(wp1, wp2, wp3, wp4, wp5, wp6, f, i, e, h, c, i5, b, h5)
+                   - xbr_hv_wd(wp1, wp2, wp3, wp4, wp5, wp6, e, f, h, i, d, f4, g, i4));
+
+    float limits = XBR_EDGE_STR + 0.000001;
+    float edge_strength = smoothstep(0.0, limits, abs(d_edge));
+
+    /* Filter weights. Two taps only. */
+    vec4 w1 = vec4(-weight1, weight1+0.5, weight1+0.5, -weight1);
+    vec4 w2 = vec4(-weight2, weight2+0.25, weight2+0.25, -weight2);
+    vec3 c3 = xbr_mul(w2, mat4x3(D+G, E+H, F+I, F4+I4));
+    vec3 c4 = xbr_mul(w2, mat4x3(C+B, F+E, I+H, I5+H5));
+
+    /* Filtering and normalization in four direction generating four colors. */
+    vec3 c1 = xbr_mul(w1, mat4x3( P2,   H,   F,   P1 ));
+    vec3 c2 = xbr_mul(w1, mat4x3( P0,   E,   I,   P3 ));
+
+    /* Smoothly blends the two strongest directions (one in diagonal and the other in vert/horiz direction). */
+    vec3 color = mix(mix(c1, c2, step(0.0, d_edge)), mix(c3, c4, step(0.0, hv_edge)), 1. - edge_strength);
+
+    /* Anti-ringing code. */
+    vec3 min_sample = xbr_min4( E, F, H, I ) + (1.-XBR_ANTI_RINGING)*mix((P2-H)*(F-P1), (P0-E)*(I-P3), step(0.0, d_edge));
+    vec3 max_sample = xbr_max4( E, F, H, I ) - (1.-XBR_ANTI_RINGING)*mix((P2-H)*(F-P1), (P0-E)*(I-P3), step(0.0, d_edge));
+    return clamp(color, min_sample, max_sample);
+}
