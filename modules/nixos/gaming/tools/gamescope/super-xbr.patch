diff --git a/src/shaders/cs_xbr_resample.comp b/src/shaders/cs_xbr_resample.comp
new file mode 100644
index 0000000..d30791b
--- /dev/null
+++ b/src/shaders/cs_xbr_resample.comp
@@ -0,0 +1,29 @@
+#version 460
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set.h"
+
+layout(
+  local_size_x = 8,
+  local_size_y = 8,
+  local_size_z = 1) in;
+
+layout(binding = 0, scalar)
+uniform layers_t {
+    uint u_srcWidth;
+    uint u_srcHeight;
+    uint u_dstWidth;
+    uint u_dstHeight;
+};
+
+// Scales the 2x Super-xBR image to the layer's on-screen size (bilinear sampler).
+void main()
+{
+    uvec2 pos = gl_GlobalInvocationID.xy;
+    if (pos.x >= u_dstWidth || pos.y >= u_dstHeight)
+        return;
+    vec2 uv = (vec2(pos) + 0.5) / vec2(u_dstWidth, u_dstHeight);
+    imageStore(dst, ivec2(pos), vec4(textureLod(s_samplers[0], uv, 0.0).rgb, 1));
+}
