diff --git a/src/shaders/cs_xbr_pass0.comp b/src/shaders/cs_xbr_pass0.comp
new file mode 100644
index 0000000..b2a3173
--- /dev/null
+++ b/src/shaders/cs_xbr_pass0.comp
@@ -0,0 +1,31 @@
+#version 460
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set.h"
+
+layout(
+  local_size_x = 8,
+  local_size_y = 8,
+  local_size_z = 1) in;
+
+layout(binding = 0, scalar)
+uniform layers_t {
+    uint u_srcWidth;
+    uint u_srcHeight;
+    uint u_dstWidth;
+    uint u_dstHeight;
+};
+
+#define XBR_PASS 0
+#include "xbr.h"
+
+void main()
+{
+    uvec2 pos = gl_GlobalInvocationID.xy;
+    if (pos.x >= u_dstWidth || pos.y >= u_dstHeight)
+        return;
+    vec2 uv = (vec2(pos) + 0.5) / vec2(u_dstWidth, u_dstHeight);
+    imageStore(dst, ivec2(pos), vec4(xbrPass(uv, vec2(u_srcWidth, u_srcHeight)), 1));
+}
