+
+#version 460
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set.h"
+
+layout(
+  local_size_x = 8,
+  local_size_y = 8,
+  local_size_z = 1) in;
+
+layout(binding = 0, scalar)
+uniform layers_t {
+    uint u_srcWidth;
+    uint u_srcHeight;
+    uint u_dstWidth;
+    uint u_dstHeight;
+};
+
+// Input pixel at (x, y), clamped to the edge.
+#define src(x, y) texelFetch(s_samplers[0], clamp(ivec2(x, y), ivec2(0), isz - 1), 0).rgb
+
+float luma(vec3 C) {
+	return C.r + C.g + C.b;
+}
+
+bool all_eq2(vec3 B, vec3 A0, vec3 A1) {
+	return (B == A0) && (B == A1);
+}
+
+bool all_eq3(vec3 B, vec3 A0, vec3 A1, vec3 A2) {
+	return (B == A0) && (B == A1) && (B == A2);
+}
+
+bool all_eq4(vec3 B, vec3 A0, vec3 A1, vec3 A2, vec3 A3) {
+	return (B == A0) && (B == A1) && (B == A2) && (B == A3);
+}
+
+bool any_eq3(vec3 B, vec3 A0, vec3 A1, vec3 A2) {
+	return (B == A0) || (B == A1) || (B == A2);
+}
+
+bool none_eq2(vec3 B, vec3 A0, vec3 A1) {
+	return (B != A0) && (B != A1);
+}
+
+bool none_eq4(vec3 B, vec3 A0, vec3 A1, vec3 A2, vec3 A3) {
+	return (B != A0) && (B != A1) && (B != A2) && (B != A3);
+}
+
+// One thread per input pixel, writing its 2x2 block of the 2x image.
+void main()
+{
+	ivec2 isz = ivec2(u_srcWidth, u_srcHeight);
+	ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
+	if (gid.x >= isz.x || gid.y >= isz.y)
+		return;
+
+	int srcX = gid.x;
+	int srcY = gid.y;
+
+	vec3 A = src(srcX - 1, srcY - 1), B = src(srcX, srcY - 1), C = src(srcX + 1, srcY - 1);
+	vec3 D = src(srcX - 1, srcY + 0), E = src(srcX, srcY + 0), F = src(srcX + 1, srcY + 0);
+	vec3 G = src(srcX - 1, srcY + 1), H = src(srcX, srcY + 1), I = src(srcX + 1, srcY + 1);
+
+	vec3 J = E, K = E, L = E, M = E;
+
+	if ((A != E) || (B != E) || (C != E) || (D != E) || (F != E) || (G != E) || (H != E) || (I != E)) {
+		vec3 P = src(srcX, srcY - 2), S = src(srcX, srcY + 2);
+		vec3 Q = src(srcX - 2, srcY), R = src(srcX + 2, srcY);
+		float Bl = luma(B), Dl = luma(D), El = luma(E), Fl = luma(F), Hl = luma(H);
+
+		// 1:1 slope rules
+		if (((D == B) && (D != H) && (D != F)) && (El >= Dl || (E == A)) && any_eq3(E, A, C, G) && ((El < Dl) || (A != D) || (E != P) || (E != Q))) J = D;
+		if (((B == F) && (B != D) && (B != H)) && (El >= Bl || (E == C)) && any_eq3(E, A, C, I) && ((El < Bl) || (C != B) || (E != P) || (E != R))) K = B;
+		if (((H == D) && (H != F) && (H != B)) && (El >= Hl || (E == G)) && any_eq3(E, A, G, I) && ((El < Hl) || (G != H) || (E != S) || (E != Q))) L = H;
+		if (((F == H) && (F != B) && (F != D)) && (El >= Fl || (E == I)) && any_eq3(E, C, G, I) && ((El < Fl) || (I != H) || (E != R) || (E != S))) M = F;
+
+		// Intersection rules
+		if (((E != F) && all_eq4(E, C, I, D, Q) && all_eq2(F, B, H)) && ((F != src(srcX + 3, srcY)))) K = M = F;
+		if (((E != D) && all_eq4(E, A, G, F, R) && all_eq2(D, B, H)) && ((D != src(srcX - 3, srcY)))) J = L = D;
+		if (((E != H) && all_eq4(E, G, I, B, P) && all_eq2(H, D, F)) && ((H != src(srcX, srcY + 3)))) L = M = H;
+		if (((E != B) && all_eq4(E, A, C, H, S) && all_eq2(B, D, F)) && ((B != src(srcX, srcY - 3)))) J = K = B;
+		if (Bl < El && all_eq4(E, G, H, I, S) && none_eq4(E, A, D, C, F)) J = K = B;
+		if (Hl < El && all_eq4(E, A, B, C, P) && none_eq4(E, D, G, I, F)) L = M = H;
+		if (Fl < El && all_eq4(E, A, D, G, Q) && none_eq4(E, B, C, I, H)) K = M = F;
+		if (Dl < El && all_eq4(E, C, F, I, R) && none_eq4(E, B, A, G, H)) J = L = D;
+
+		// 2:1 slope rules
+		if ((H != B)) {
+			if ((H != A) && (H != E) && (H != C)) {
+				if (all_eq3(H, G, F, R) && none_eq2(H, D, src(srcX + 2, srcY - 1))) L = M;
+				if (all_eq3(H, I, D, Q) && none_eq2(H, F, src(srcX - 2, srcY - 1))) M = L;
+			}
+
+			if ((B != I) && (B != G) && (B != E)) {
+				if (all_eq3(B, A, F, R) && none_eq2(B, D, src(srcX + 2, srcY + 1))) J = K;
+				if (all_eq3(B, C, D, Q) && none_eq2(B, F, src(srcX - 2, srcY + 1))) K = J;
+			}
+		} // H !== B
+
+		if ((F != D)) {
+			if ((D != I) && (D != E) && (D != C)) {
+				if (all_eq3(D, A, H, S) && none_eq2(D, B, src(srcX + 1, srcY + 2))) J = L;
+				if (all_eq3(D, G, B, P) && none_eq2(D, H, src(srcX + 1, srcY - 2))) L = J;
+			}
+
+			if ((F != E) && (F != A) && (F != G)) {
+				if (all_eq3(F, C, H, S) && none_eq2(F, B, src(srcX - 1, srcY + 2))) K = M;
+				if (all_eq3(F, I, B, P) && none_eq2(F, H, src(srcX - 1, srcY - 2))) M = K;
+			}
+		} // F !== D
+	} // not constant
+
+	ivec2 o = gid * 2;
+	imageStore(dst, o, vec4(J, 1));
+	imageStore(dst, o + ivec2(1, 0), vec4(K, 1));
+	imageStore(dst, o + ivec2(0, 1), vec4(L, 1));
+	imageStore(dst, o + ivec2(1, 1), vec4(M, 1));
+}
diff --git a/src/shaders/cs_sharp_bilinear.comp b/src/shaders/cs_sharp_bilinear.comp
new file mode 100644
index 0000000..cd75a4a
--- /dev/null
+++ b/src/shaders/cs_sharp_bilinear.comp
@@ -0,0 +1,46 @@
+// Sharp bilinear, ported from libretro's sharp-bilinear (Themaister, public domain)
+// by way of Magpie's SharpBilinear.hlsl: nearest-neighbour to the integer scale,
+// then bilinear for the rest, in one bilinear tap.
+
+#version 460
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set.h"
+
+layout(
+  local_size_x = 8,
+  local_size_y = 8,
+  local_size_z = 1) in;
+
+layout(binding = 0, scalar)
+uniform layers_t {
+    uint u_srcWidth;
+    uint u_srcHeight;
+    uint u_dstWidth;
+    uint u_dstHeight;
+};
+
+void main()
+{
+    uvec2 pos = gl_GlobalInvocationID.xy;
+    if (pos.x >= u_dstWidth || pos.y >= u_dstHeight)
+        return;
+
+    vec2 inputSize = vec2(u_srcWidth, u_srcHeight);
+    vec2 scale = vec2(u_dstWidth, u_dstHeight) / inputSize;
+    vec2 uv = (vec2(pos) + 0.5) / vec2(u_dstWidth, u_dstHeight);
+
+    vec2 texel = uv * inputSize;
+    vec2 texel_floored = floor(texel);
+    vec2 s = fract(texel);
+    vec2 region_range = 0.5 - 0.5 / scale;
+
+    // Where in the texel to sample to get the pre-scaled bilinear result.
+    vec2 center_dist = s - 0.5;
+    vec2 f = (center_dist - clamp(center_dist, -region_range, region_range)) * scale + 0.5;
+
+    vec2 mod_texel = texel_floored + f;
+    imageStore(dst, ivec2(pos), vec4(textureLod(s_samplers[0], mod_texel / inputSize, 0.0).rgb, 1));
+}
