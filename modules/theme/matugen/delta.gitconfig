[delta "dank"]
	blame-palette = "{{colors.background.default.hex}} {{colors.surface.default.hex}} {{colors.surface_container_high.default.hex}} {{colors.surface_container_highest.default.hex}}"
	commit-decoration-style = "{{colors.outline.default.hex}}" bold box ul
	dark = true
	syntax-theme = base16
	file-decoration-style = "{{colors.outline.default.hex}}"
	file-style = "{{colors.on_surface.default.hex}}"
	hunk-header-decoration-style = "{{colors.outline.default.hex}}" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "{{colors.on_surface_variant.default.hex}}"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "{{colors.outline.default.hex}}"
	line-numbers-minus-style = bold "{{dank16.color1.default.hex}}"
	line-numbers-plus-style = bold "{{dank16.color2.default.hex}}"
	line-numbers-right-style = "{{colors.outline.default.hex}}"
	line-numbers-zero-style = "{{colors.outline.default.hex}}"
	minus-emph-style = bold syntax "{{dank16.color1.default.hex | to_color | set_saturation: 30.0 | set_lightness: 32.0 | format: "hex"}}"
	minus-style = syntax "{{dank16.color1.default.hex | to_color | set_saturation: 25.0 | set_lightness: 22.0 | format: "hex"}}"
	plus-emph-style = bold syntax "{{dank16.color2.default.hex | to_color | set_saturation: 30.0 | set_lightness: 32.0 | format: "hex"}}"
	plus-style = syntax "{{dank16.color2.default.hex | to_color | set_saturation: 25.0 | set_lightness: 22.0 | format: "hex"}}"
	map-styles = \
		bold purple => syntax "{{colors.primary.default.hex | to_color | set_saturation: 30.0 | set_lightness: 32.0 | format: "hex"}}", \
		bold blue => syntax "{{dank16.color4.default.hex | to_color | set_saturation: 30.0 | set_lightness: 32.0 | format: "hex"}}", \
		bold cyan => syntax "{{dank16.color14.default.hex | to_color | set_saturation: 30.0 | set_lightness: 32.0 | format: "hex"}}", \
		bold yellow => syntax "{{dank16.color3.default.hex | to_color | set_saturation: 30.0 | set_lightness: 32.0 | format: "hex"}}"
