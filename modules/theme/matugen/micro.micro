color-link default "{{colors.on_surface.default.hex}},{{colors.background.default.hex}}"
color-link comment "{{colors.on_surface_variant.default.hex}}"
color-link selection "{{colors.on_surface.default.hex}},{{colors.surface_container_highest.default.hex}}"
color-link hlsearch "{{dank16.color14.default.hex}}"

color-link identifier "{{dank16.color4.default.hex}}"
color-link identifier.class "{{dank16.color4.default.hex}}"
color-link identifier.var "{{dank16.color4.default.hex}}"

color-link constant "{{dank16.color11.default.hex}}"
color-link constant.number "{{dank16.color11.default.hex}}"
color-link constant.string "{{dank16.color2.default.hex}}"

color-link symbol "{{dank16.color13.default.hex}}"
color-link symbol.brackets "{{dank16.color9.default.hex}}"
color-link symbol.tag "{{dank16.color4.default.hex}}"

color-link type "{{dank16.color4.default.hex}}"
color-link type.keyword "{{dank16.color3.default.hex}}"

color-link special "{{dank16.color13.default.hex}}"
color-link statement "{{colors.primary.default.hex}}"
color-link preproc "{{dank16.color13.default.hex}}"

color-link underlined "{{dank16.color14.default.hex}}"
color-link error "bold {{dank16.color1.default.hex}}"
color-link todo "bold {{dank16.color3.default.hex}}"

color-link diff-added "{{dank16.color2.default.hex}}"
color-link diff-modified "{{dank16.color3.default.hex}}"
color-link diff-deleted "{{dank16.color1.default.hex}}"

color-link gutter-error "{{dank16.color1.default.hex}}"
color-link gutter-warning "{{dank16.color3.default.hex}}"

color-link scrollbar "{{colors.on_surface_variant.default.hex}}"
color-link statusline "{{colors.on_surface.default.hex}},{{colors.surface.default.hex}}"
color-link tabbar "{{colors.on_surface.default.hex}},{{colors.surface.default.hex}}"
color-link indent-char "{{colors.surface_container_highest.default.hex}}"
color-link line-number "{{colors.surface_container_highest.default.hex}}"
color-link current-line-number "{{colors.secondary.default.hex}}"

color-link cursor-line "{{colors.surface_container_high.default.hex}},{{colors.on_surface.default.hex}}"
color-link color-column "{{colors.surface_container_high.default.hex}}"
color-link type.extended "default"
