#=====================================================================#
# COSMIC THEMES
#=====================================================================#
_: {
  #--------------------------------------------------------------------#
  #-- Importable Theme Files
  #--------------------------------------------------------------------#
  # COSMIC has no declarative theme import. Apply once per machine via
  # Settings -> Appearance -> Import theme, picking the file below; it then
  # persists in com.system76.CosmicTheme.Dark.Builder, which is left
  # undeclared so the import is not overwritten.
  #
  # Source: github.com/catppuccin/cosmic-desktop (themes/cosmic-settings)
  home.file.".local/share/cosmic-themes/catppuccin-mocha-mauve.ron".source =
    ./catppuccin-mocha-mauve.ron;
}
