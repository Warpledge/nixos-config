+/** A source's whole filter tree as search input, in the order it was served. */
+export function filterInputsOf(nodes: FilterNode[]): FilterInput[] {
+  return nodes.map((n): FilterInput => {
+    switch (n.__typename) {
+      case "SelectFilter":   return { name: n.name, select: { state: n.state } };
+      case "TextFilter":     return { name: n.name, text: { state: n.state } };
+      case "CheckBoxFilter": return { name: n.name, checkbox: { state: n.state } };
+      case "TriStateFilter": return { name: n.name, tristate: { state: n.state } };
+      case "SortFilter":     return { name: n.name, sort: { hasState: n.hasState, index: n.index, ascending: n.ascending } };
+      case "GroupFilter":    return { name: n.name, group: { children: filterInputsOf(n.children) } };
+      default:               return { name: n.name };
+    }
+  });
+}
