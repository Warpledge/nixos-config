+// GraphQL rejects a fragment that spreads itself, so groups are expanded two levels deep, and
+// `state` differs in type per filter kind, so each kind aliases it and withState() renames it back.
 const FILTER_NODE_FRAGMENT = `
-	fragment FilterNodeFields on FilterNode {
+	fragment FilterLeafFields on FilterNode {
 		__typename
 		... on HeaderFilter    { name }
 		... on SeparatorFilter { name }
-		... on SelectFilter    { name values state }
-		... on TextFilter      { name state }
-		... on CheckBoxFilter  { name state }
-		... on TriStateFilter  { name state }
+		... on SelectFilter    { name values selectState: state }
+		... on TextFilter      { name textState: state }
+		... on CheckBoxFilter  { name checkState: state }
+		... on TriStateFilter  { name triState: state }
 		... on SortFilter      { name values hasState index ascending }
+	}
+	fragment FilterNodeFields on FilterNode {
+		...FilterLeafFields
 		... on GroupFilter {
 			name
-			children { ...FilterNodeFields }
+			children {
+				...FilterLeafFields
+				... on GroupFilter { name children { ...FilterLeafFields } }
+			}
 		}
 	}
 `
 
+const STATE_ALIASES = ["selectState", "textState", "checkState", "triState"]
+
+function withState(nodes: any[]): FilterNode[] {
+	return nodes.map((n) => {
+		const out: any = { ...n }
+		for (const a of STATE_ALIASES) if (a in out) { out.state = out[a]; delete out[a] }
+		if (out.children) out.children = withState(out.children)
+		return out
+	})
+}
