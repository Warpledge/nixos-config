+// viaSandbox fetches the cover with the source extension's own client, for covers that need
+// its headers or cookies, or that only the extension can serve.
+func (h *CoverProxyHandler) viaSandbox(ctx context.Context, entry sqlcgen.Medium, candidates []string, destName string) string {
+	if h.Sc == nil || !entry.ExtensionID.Valid {
+		return ""
+	}
+	ext, err := h.Q.GetExtension(ctx, entry.ExtensionID.Int64)
+	if err != nil {
+		return ""
+	}
+	c, err := h.Sc.Ensure(ctx)
+	if err != nil {
+		return ""
+	}
+	for _, u := range candidates {
+		img, err := c.GetImageBytes(ctx, ext.PackageName, u)
+		if err != nil {
+			continue
+		}
+		if p, err := image.SaveBytesToFile(img.GetData(), img.GetContentType(), h.CoverCacheDir, destName); err == nil {
+			return p
+		}
+	}
+	return ""
+}
