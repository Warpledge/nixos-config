 void
+drw_draw_line(struct drwsurf *ds, Color color, double x0, double y0, double x1,
+              double y1, double width)
+{
+    drwsurf_flip(ds);
+    struct drwbuf *d = ds->back_buffer;
+    double left = (x0 < x1 ? x0 : x1) - width, top = (y0 < y1 ? y0 : y1) - width;
+    double right = (x0 > x1 ? x0 : x1) + width, bottom = (y0 > y1 ? y0 : y1) + width;
+    drwsurf_damage(ds, left < 0 ? 0 : left, top < 0 ? 0 : top,
+                   right - left + 1, bottom - top + 1);
+
+    cairo_save(d->cairo);
+    cairo_set_operator(d->cairo, CAIRO_OPERATOR_OVER);
+    cairo_set_source_rgba(
+      d->cairo, color.bgra[2] / (double)255, color.bgra[1] / (double)255,
+      color.bgra[0] / (double)255, color.bgra[3] / (double)255);
+    cairo_set_line_width(d->cairo, width);
+    cairo_set_line_cap(d->cairo, CAIRO_LINE_CAP_ROUND);
+    cairo_move_to(d->cairo, x0, y0);
+    cairo_line_to(d->cairo, x1, y1);
+    cairo_stroke(d->cairo);
+    cairo_restore(d->cairo);
+}
