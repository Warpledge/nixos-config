# wvkbd: swipe mode (SIGRTMIN+1, or WVKBD_SWIPE at start). A first finger on a letter sends
# nothing until it lifts: a tap types the letter, a stroke prints keys on stdout.
--- a/main.c
+++ b/main.c
@@ -6,6 +6,7 @@
 #include "proto/input-method-unstable-v2-protocol.h"
 #include <errno.h>
