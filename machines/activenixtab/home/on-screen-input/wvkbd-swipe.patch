+#include <ctype.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -104,6 +105,8 @@
 #define MAX_FINGERS 10
 #define SLIDE_AFTER_MS 150 /* held this long, sliding presses the next key */
 #define MOD_TAP_MS 300     /* a modifier let go sooner, unused, latches */
+#define STROKE_MAX 63
+#define STROKE_TAP_MS 150  /* two keys crossed this fast is a tap that drifted */
 
 static struct finger {
     bool down;
@@ -112,8 +115,40 @@
     struct key *mod; /* the modifier it holds */
     bool mod_used;
     uint32_t time;
+    /* Swipe mode: letters crossed so far, nothing sent until it lifts */
+    char stroke[STROKE_MAX + 1];
+    int stroke_len;
+    struct key *stroke_first, *stroke_last;
 } fingers[MAX_FINGERS];
 
+static bool swipe_mode = false;
+
+static bool
+is_letter(struct key *k)
+{
+    return k && k->type == Code && strlen(k->label) == 1 && isalpha(k->label[0]);
+}
+
+static bool
+stroke_can_start(struct key *k)
+{
+    if (!swipe_mode || !is_letter(k) || (keyboard.mods & (Ctrl | Alt | Super)))
+        return false;
+    for (int i = 0; i < MAX_FINGERS; i++)
+        if (fingers[i].down)
+            return false;
+    return true;
+}
+
+static void
+stroke_add(struct finger *f, struct key *k)
+{
+    if (f->stroke_len < STROKE_MAX)
+        f->stroke[f->stroke_len++] = tolower(k->label[0]);
+    f->stroke_last = k;
+    kbd_draw_key(&keyboard, k, f->stroke_len > 1 ? Swipe : Press);
+}
+
 static struct finger *
 finger_find(int32_t id)
 {
