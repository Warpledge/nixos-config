 } fingers[MAX_FINGERS];
 
+static bool swipe_mode = false;
+
+static bool
+is_letter(struct key *k)
+{
+    return k && k->type == Code && strlen(k->label) == 1 && isalpha(k->label[0]);
+}
+
+static bool
+stroke_can_start(struct key *k)
+{
+    if (!swipe_mode || !is_letter(k) || (keyboard.mods & (Ctrl | Alt | Super)))
+        return false;
+    for (int i = 0; i < MAX_FINGERS; i++)
+        if (fingers[i].down)
+            return false;
+    return true;
+}
+
+static void
+stroke_add(struct finger *f, struct key *k)
+{
+    if (f->stroke_len < STROKE_MAX)
+        f->stroke[f->stroke_len++] = tolower(k->label[0]);
+    f->stroke_last = k;
+    if (f->stroke_len == 1)
+        kbd_draw_key(&keyboard, k, Press);
+}
+
+/* The line behind the finger; the first few px don't count, so taps show none */
+static void
+stroke_trail(struct finger *f, double x, double y)
+{
+    double dx = x - f->trail_x, dy = y - f->trail_y;
+    if (!f->trail_started && dx * dx + dy * dy < TRAIL_START_PX * TRAIL_START_PX)
+        return;
+    f->trail_started = true;
+    drw_draw_line(keyboard.surf, keyboard.schemes[f->stroke_first->scheme].swipe,
+                  f->trail_x, f->trail_y, x, y, TRAIL_WIDTH_PX);
+    f->trail_x = x;
+    f->trail_y = y;
+}
