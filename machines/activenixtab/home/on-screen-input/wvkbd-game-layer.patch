+/* Waits for every finger to lift: remaking the surface under one would lose it */
+static void
+game_sync(void)
+{
+    bool want = keyboard.layout == &keyboard.layouts[Game];
+    if (want == game_mode || hidden)
+        return;
+    for (int i = 0; i < MAX_FINGERS; i++)
+        if (fingers[i].down)
+            return;
+    game_mode = want;
+    const char *state = getenv("WVKBD_GAME_STATE");
+    if (want) {
+        game_print = keyboard.print;
+        keyboard.print = false;
+        FILE *f = state ? fopen(state, "w") : NULL;
+        if (f)
+            fclose(f);
+    } else {
+        keyboard.print = game_print;
+        if (state)
+            unlink(state);
+    }
+    hide();
+    show();
+}
