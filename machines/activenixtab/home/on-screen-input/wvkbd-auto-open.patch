# wvkbd --auto: act on the input method only at "done", and close a keyboard a text field opened
# only after a short delay. SIGRTMIN+3/+4 or WVKBD_IM_BLOCKED stop fields opening it (folio-watch.py).
--- a/main.c
+++ b/main.c
@@ -13,6 +13,7 @@
 #include <sys/mman.h>
 #include <sys/signalfd.h>
 #include <poll.h>
+#include <time.h>
 #include <unistd.h>
 #include <wayland-client-protocol.h>
 #include <wayland-client.h>
@@ -75,6 +76,11 @@
 static int rounding = DEFAULT_ROUNDING;
 static bool hidden = false;
 static bool im_auto = false;
+static bool im_wanted = false, im_active = false;
+static bool im_opened = false;  /* shown by a text field, not by hand */
+static bool im_blocked = false; /* folio-watch.py: don't open on text fields */
+#define IM_CLOSE_DELAY_MS 300
+static int64_t im_close_at = 0; /* when a field-opened keyboard closes; 0 for never */
 static uint32_t custom_width = 0;
 static double width_ratio = 1.0;
 static enum { DOCK_FULL = 0, DOCK_LEFT = 1, DOCK_RIGHT = 2 } dock_mode = DOCK_FULL;
@@ -721,16 +727,24 @@
         .preferred_scale = wp_fractional_scale_preferred_scale,
 };
 
+static int64_t
+now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
 void
 im_activate(void *data, struct zwp_input_method_v2 *zwp_input_method_v2)
 {
-    show();
+    im_wanted = true;
 }
 
 void
 im_deactivate(void *data, struct zwp_input_method_v2 *zwp_input_method_v2)
 {
-    hide();
+    im_wanted = false;
 }
 
 void
@@ -752,6 +766,20 @@
 void
 im_done(void *data, struct zwp_input_method_v2 *zwp_input_method_v2)
 {
+    /* Only a keyboard a text field opened closes with it, and after a delay, since
+     * moving between fields deactivates the old one before activating the new one. */
+    if (im_wanted == im_active)
+        return;
+    im_active = im_wanted;
+    if (im_active) {
+        im_close_at = 0;
+        if (!im_blocked && hidden) {
+            show();
+            im_opened = true;
+        }
+    } else if (im_opened) {
+        im_close_at = now_ms() + IM_CLOSE_DELAY_MS;
+    }
 }
 
