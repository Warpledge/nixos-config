@@ -1043,6 +1071,7 @@
 void
 toggle_visibility()
 {
+    im_opened = false;
     if (hidden)
         show();
     else
@@ -1109,6 +1138,7 @@
     if ((tmp = getenv("WVKBD_LANDSCAPE_LAYERS")))
