+                if (im_opened && !hidden)
+                    hide();
+                im_opened = false;
+            } else {
+                timeout = (int)left;
+            }
+        }
+
         wl_display_flush(display);
-        poll(fds, 3, -1);
+        poll(fds, 3, timeout);
 
         if ((fds[LED_FD].revents & POLLIN) && kbd_read_leds(&keyboard) && !hidden)
             kbd_draw_layout(&keyboard);
