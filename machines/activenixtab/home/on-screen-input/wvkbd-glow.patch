 void
+drw_draw_glow(struct drwsurf *ds, Color color, int x, int y, int w, int h,
+              int spread)
+{
+    drwsurf_flip(ds);
+    struct drwbuf *d = ds->back_buffer;
+    int left = x - spread < 0 ? 0 : x - spread;
+    int top = y - spread < 0 ? 0 : y - spread;
+    drwsurf_damage(ds, left, top, x + w + spread - left, y + h + spread - top);
+
+    double r = color.bgra[2] / 255.0, g = color.bgra[1] / 255.0;
+    double b = color.bgra[0] / 255.0;
+    cairo_pattern_t *fade = cairo_pattern_create_radial(0, 0, 0, 0, 0, 1);
+    cairo_pattern_add_color_stop_rgba(fade, 0.55, r, g, b, 0.7);
+    cairo_pattern_add_color_stop_rgba(fade, 1.0, r, g, b, 0.0);
+
+    /* An ellipse around the key, fading out over its neighbours */
+    cairo_save(d->cairo);
+    cairo_set_operator(d->cairo, CAIRO_OPERATOR_OVER);
+    cairo_translate(d->cairo, x + w / 2.0, y + h / 2.0);
+    cairo_scale(d->cairo, w / 2.0 + spread, h / 2.0 + spread);
+    cairo_set_source(d->cairo, fade);
+    cairo_arc(d->cairo, 0, 0, 1, 0, 2 * M_PI);
+    cairo_fill(d->cairo);
+    cairo_restore(d->cairo);
+    cairo_pattern_destroy(fade);
+}
