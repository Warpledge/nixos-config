+#define KEY_GLOW_PX 22
+
+static bool
+keys_touch(struct key *a, int x, int y, int w, int h)
+{
+    return (int)a->x < x + w && (int)(a->x + a->w) > x && (int)a->y < y + h &&
+           (int)(a->y + a->h) > y;
+}
+
+/* A key at rest: a latched modifier shows pressed, everything else plain */
+static void
+draw_resting_key(struct kbd *kb, struct key *k)
+{
+    if (k->type == Mod)
+        k->glowing = false;
+    if ((k->type == Mod && kb->mods & k->code) ||
+        (k->type == Compose && kb->compose)) {
+        kbd_draw_key(kb, k, Press);
+    } else if (!k->glowing) {
+        kbd_draw_key(kb, k, None);
+    }
+}
+
+/* Takes a released key's glow off its neighbours; other held keys keep theirs */
+static void
+clear_glow(struct kbd *kb, struct key *k)
+{
+    int x = (int)k->x - KEY_GLOW_PX, y = (int)k->y - KEY_GLOW_PX;
+    int w = k->w + 2 * KEY_GLOW_PX, h = k->h + 2 * KEY_GLOW_PX;
+    x = x < 0 ? 0 : x;
+    y = y < 0 ? 0 : y;
+    drw_fill_rectangle(kb->surf, kb->schemes[0].bg, x, y, w, h, 0);
+    for (struct key *n = kb->layout->keys; n->type != Last; n++) {
+        if (n->type != Pad && n->type != EndRow && keys_touch(n, x, y, w, h))
+            draw_resting_key(kb, n);
+    }
+    for (struct key *n = kb->layout->keys; n->type != Last; n++) {
+        if (n->type != Pad && n->type != EndRow && n->glowing && n->type != Mod)
+            kbd_draw_key(kb, n, Press);
+    }
+}
