# Adds a PAD key (F13) to wvkbd's deskintl bottom rows (full and
# special layers): take 1.5 units from the space bar so the rows still
# sum to 13.5. PAD makes KEY_F13, which niri binds to the pad-mode toggle.
--- a/layout.deskintl.h	2026-07-24 14:16:05.000000000 -0700
+++ b/layout.deskintl.h	2026-10-30 16:54:21.927704930 -0700
@@ -229,7 +229,8 @@
   {"Ctr", "Ctr", 1.0, Mod, Ctrl, .scheme = 1},
   {"Sup", "Sup", 1.0, Mod, Super, .scheme = 1},
   {"Alt", "Alt", 1.0, Mod, Alt, .scheme = 1},
-  {"", "", 5.0, Code, KEY_SPACE},
+  {"PAD", "PAD", 1.5, Code, KEY_F13, .scheme = 1},
+  {"", "", 3.5, Code, KEY_SPACE},
   {"AGr", "AGr", 1.0, Mod, AltGr, .scheme = 1},
   {"Ctr", "Ctr", 1.0, Mod, Ctrl, .scheme = 1},
   {"←", "←", 1.0, Code, KEY_LEFT, .scheme = 1},
@@ -265,7 +266,8 @@
   {"Ctr", "Ctr", 1.0, Mod, Ctrl, .scheme = 1},
   {"Sup", "Sup", 1.0, Mod, Super, .scheme = 1},
   {"Alt", "Alt", 1.0, Mod, Alt, .scheme = 1},
-  {"", "", 5.0, Pad},
+  {"PAD", "PAD", 1.5, Code, KEY_F13, .scheme = 1},
+  {"", "", 3.5, Pad},
   {"AGr", "AGr", 1.0, Mod, AltGr, .scheme = 1},
   {"Ctr", "Ctr", 1.0, Mod, Ctrl, .scheme = 1},
   {"Home", "Home", 1.0, Code, KEY_HOME, .scheme = 1},
