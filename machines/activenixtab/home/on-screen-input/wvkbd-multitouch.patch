+/* One entry per finger on the keyboard, so several keys can be held at once.
+ * kbd_press_key and kbd_unpress_key work on keyboard.last_press, which is set
+ * around each call. */
+#define MAX_FINGERS 10
+#define SLIDE_AFTER_MS 150 /* held this long, sliding presses the next key */
+#define MOD_TAP_MS 300     /* a modifier let go sooner, unused, latches */
+
+static struct finger {
+    bool down;
+    int32_t id;
+    struct key *key; /* the Code or Copy key it holds */
+    struct key *mod; /* the modifier it holds */
+    bool mod_used;
+    uint32_t time;
+} fingers[MAX_FINGERS];
+
+static struct finger *
+finger_find(int32_t id)
+{
+    for (int i = 0; i < MAX_FINGERS; i++)
+        if (fingers[i].down && fingers[i].id == id)
+            return &fingers[i];
+    return NULL;
+}
+
+static void
+finger_press_key(struct finger *f, struct key *k, uint32_t time)
+{
+    keyboard.last_press = NULL;
+    kbd_press_key(&keyboard, k, time);
+    f->key = keyboard.last_press;
+    keyboard.last_press = NULL;
+    if (f->key) {
+        for (int i = 0; i < MAX_FINGERS; i++)
+            fingers[i].mod_used = true;
+    }
+}
+
+static void
+finger_release_key(struct finger *f, uint32_t time)
+{
+    if (!f->key)
+        return;
+    keyboard.last_press = f->key;
+    kbd_release_key(&keyboard, time);
+    f->key = NULL;
+}
+
+static void
+finger_press(int32_t id, struct key *k, uint32_t time)
+{
+    struct finger *f = NULL;
+    for (int i = 0; i < MAX_FINGERS && !f; i++)
+        if (!fingers[i].down)
+            f = &fingers[i];
+    if (!f)
+        return;
+    *f = (struct finger){.down = true, .id = id, .time = time};
+    finger_press_key(f, k, time);
+    /* Pressing a latched modifier turns it off; there's nothing to hold then */
+    if (k->type == Mod && (keyboard.mods & k->code)) {
+        f->mod = k;
+        keyboard.held_mods |= k->code;
+    }
+}
+
+static void
+finger_up(int32_t id, uint32_t time)
+{
+    struct finger *f = finger_find(id);
+    if (!f)
+        return;
+    finger_release_key(f, time);
+    if (f->mod) {
+        uint32_t code = f->mod->code;
+        keyboard.held_mods &= ~code;
+        if ((keyboard.mods & code) &&
+            (f->mod_used || time - f->time >= MOD_TAP_MS)) {
+            /* It worked as a held key, so lifting ends it */
+            kbd_release_mod(&keyboard, code, time);
+        }
+    }
+    f->down = false;
+}
+
+static void
+finger_motion(int32_t id, struct key *k, uint32_t time)
+{
+    struct finger *f = finger_find(id);
+    if (!f || !f->key || f->key == k)
+        return;
+    finger_release_key(f, time);
+    /* A quick drift just ends the press, so taps don't type a neighbour */
+    if (k && k->type == Code && time - f->time >= SLIDE_AFTER_MS)
+        finger_press_key(f, k, time);
+}
+
+static void
+fingers_release_all(uint32_t time)
+{
+    for (int i = 0; i < MAX_FINGERS; i++)
+        if (fingers[i].down)
+            finger_up(fingers[i].id, time);
+}
