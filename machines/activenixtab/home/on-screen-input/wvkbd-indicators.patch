+int
+kbd_led_fd(void)
+{
+    return uinput_fd;
+}
+
+/* True if caps lock changed */
+bool
+kbd_read_leds(struct kbd *kb)
+{
+    struct input_event ev;
+    bool changed = false;
+    while (read(uinput_fd, &ev, sizeof(ev)) == sizeof(ev)) {
+        if (ev.type == EV_LED && ev.code == LED_CAPSL && kb->caps_lit != !!ev.value) {
+            kb->caps_lit = !!ev.value;
+            changed = true;
+        }
+    }
+    return changed;
+}
